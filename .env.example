# ---- database (Supabase Postgres) -------------------------------------------
# Use the *pooler* connection string (Transaction mode, port 6543) on Vercel.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ---- public URL of this deployment (used in unsubscribe links) ---------------
PUBLIC_BASE_URL=https://email-boss.vercel.app

# ---- secrets (generate with: openssl rand -base64 32) ------------------------
UNSUBSCRIBE_SECRET=
# UNSUBSCRIBE_SECRET_PREVIOUS=        # only while rotating
CRON_SECRET=
ADMIN_PASSWORD=                       # 12+ chars, for /admin

# ---- sending -----------------------------------------------------------------
# Safety switch. Anything other than "true" = dry run (nothing is emailed).
SEND_ENABLED=false
EMAIL_PROVIDER=ses                    # ses | resend | log  (brand.json "provider" overrides)
SEND_RATE_PER_SECOND=1                # SES sandbox is 1/s; raise to your SES max send rate later
SEND_BATCH_LIMIT=200                  # max emails per cron run
SEND_TIME_BUDGET_MS=45000

# Amazon SES (IAM user limited to ses:SendEmail)
SES_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Comma-separated SNS topic ARNs allowed to call /api/webhooks/ses
SNS_TOPIC_ARNS=

# Resend (optional alternative provider)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=                # whsec_... for /api/webhooks/resend

# npm run test-send only delivers to these addresses (comma-separated)
TEST_RECIPIENTS=

# ---- build -------------------------------------------------------------------
# ":"-separated roots of brand folders compiled into the app (default: brands)
# BRANDS_DIRS=brands
